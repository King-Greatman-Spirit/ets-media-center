APP_NAME=ETS Media Command Center
APP_VERSION=1.0.0
ENVIRONMENT=development
SECRET_KEY=change-me-in-production-jwt-super-secret-key
JWT_EXPIRY_MINUTES=60

# --- Frontend (Vite): required for sign-in / sign-up / Google ---
# Copy this file to .env and fill these in, then restart `npm run dev`.
# Vite only exposes vars prefixed with VITE_ to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

DATABASE_URL=postgresql://ets:ets@localhost:5432/ets
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

OPENAI_API_KEY=
# Free alternative (no card needed): Google AI Studio key from https://aistudio.google.com.
# When set, the Studio uses Gemini 2.0 Flash free tier instead of OpenAI.
GOOGLE_GENERATIVE_AI_API_KEY=
WHISPER_MODEL=large-v3

YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

TELEGRAM_BOT_TOKEN=

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

STORAGE_PATH=./storage
MAX_FILE_SIZE=2147483648
